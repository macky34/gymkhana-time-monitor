// Copy to config.h and fill in per device. config.h is gitignored so each
// physical sensor keeps its own build-time identity.
#pragma once

// Venue WiFi (the RPi's hotspot / LAN).
#define WIFI_SSID "timemon-lan"
#define WIFI_PASS "changeme"

// RPi address on the LAN: UDP trigger/heartbeat target + SNTP + config host.
#define RPI_HOST "192.168.50.1"
#define RPI_UDP_PORT 9999
#define RPI_HTTP_PORT 8080 // for GET /api/internal/sensor-config

// Local UDP port this sensor listens on for the server's "config" reply
// piggybacked on heartbeat responses (issue #18: live lockout reload).
#define LOCAL_UDP_PORT 9999

// --- Seeed Studio XIAO ESP32C5 (env:seeed_xiao_esp32c5), the default board --
#define SENSOR_GPIO 0        // D1 pin (GPIO0)
#define STATUS_LED_GPIO 24   // D5, external LED1 via MOSFET (GPIO27 is LED_BUILTIN-only, not header-accessible)
#define LED_ACTIVE_LOW 0     // external LED1 is lit when the GPIO is driven HIGH (MOSFET gate)
#define PILOT_LED_GPIO 11    // D6, external LED2 (pilot lamp) via its own MOSFET, active-high
#define MODE_SWITCH_GPIO 8   // D8, start/goal role switch (INPUT_PULLUP, GND=Goal, OPEN=Start)
#define LINK_SWITCH_GPIO 9   // D9, ESP-NOW enable switch (INPUT_PULLUP, GND=ESP-NOW client, OPEN=WiFi-direct)
// USE_EXTERNAL_ANTENNA has no effect on the C5 (no antenna switch; fixed
// onboard u.FL antenna) -- leave it undefined. WiFi band is pinned to 2.4GHz
// in main.cpp since the C5 is dual-band and the venue AP is 2.4GHz-only.

// Fallback debounce lockout if the server config fetch fails (ms; the
// server config wire protocol itself is in seconds, but this internal
// fallback stays in ms to match lockoutMs's internal representation).
#define DEFAULT_LOCKOUT_MS 10000  // 10 seconds

// Uncomment to try ESP-NOW Long Range mode (longer range, lower rate).
// Falls back to normal rate automatically if the underlying esp_wifi call
// fails. Both sensors run the same firmware, so this stays in sync between
// host and client without needing runtime negotiation. Default off --
// enable only after comparing range/RSSI against normal mode outdoors.
// #define ESPNOW_LR_MODE

// --- Debug mode (issue #44) -------------------------------------------------
// Uncomment ONE of these to override the physical role/link switch at boot
// (for bench testing without wiring a switch). Leave both undefined to use
// the switch as normal.
// #define DEBUG_FORCE_ROLE_START
// #define DEBUG_FORCE_ROLE_GOAL
// #define DEBUG_FORCE_LINK_ESPNOW
// #define DEBUG_FORCE_LINK_WIFI

// Uncomment for verbose Serial logging: LED pattern/link-background
// transitions, NTP sync status. Default off.
// #define DEBUG_VERBOSE

// --- Seeed Studio XIAO ESP32C6 (env:seeed_xiao_esp32c6) ---------------------
// Uncomment/replace the above when building for the XIAO ESP32C6 instead:
//   #define SENSOR_GPIO 1        // D1 pin (GPIO1)
//   #define STATUS_LED_GPIO 23   // D5, external LED1 via its own MOSFET (see C5 comment above)
//   #define LED_ACTIVE_LOW 0     // external LED1 is lit when driven HIGH (MOSFET gate)
//   #define PILOT_LED_GPIO 16    // D6, external LED2 (pilot lamp) via its own MOSFET, active-high
//   #define MODE_SWITCH_GPIO 19  // D8, start/goal role switch (INPUT_PULLUP, GND=Goal, OPEN=Start)
//   #define LINK_SWITCH_GPIO 20  // D9, ESP-NOW enable switch (INPUT_PULLUP, GND=ESP-NOW client, OPEN=WiFi-direct)
//   #define USE_EXTERNAL_ANTENNA 0  // 0 = onboard chip antenna, 1 = external (u.FL)
